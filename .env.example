SECRET_KEY=
DEBUG=True

# Base locale simple pour vérifier rapidement (SQLite, aucun service à installer).
# Remplace par ton PostgreSQL local si tu préfères, par exemple :
# DATABASE_URL=postgres://bug_user:motdepasse@localhost:5432/bugtracker
DATABASE_URL=sqlite:///db.sqlite3

# Emails : backend console en dev (rien à configurer, les emails s'affichent dans le terminal)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=BugTracker <no-reply@bugtracker.local>