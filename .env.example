SECRET_KEY=
DEBUG=True

# Base locale simple pour vérifier rapidement (SQLite, aucun service à installer).
# Remplace par ton PostgreSQL local si tu préfères, par exemple :
# DATABASE_URL=postgres://bug_user:motdepasse@localhost:5432/bugtracker
DATABASE_URL=sqlite:///db.sqlite3

# Emails : backend console en dev (rien à configurer, les emails s'affichent dans le terminal)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=BugTracker <no-reply@bugtracker.local>

# Cle api pour ton IA
# AI_PROVIDER=openai
# OPENAI_API_KEY=colle-ici-ta-cle-secrete

# Modèle précis. Laisse cette ligne commentée pour utiliser
# le modèle par défaut du fournisseur.
# AI_MODEL=

# Pour passer à Claude, ces deux lignes suffisent :
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=colle-ici-ta-cle-secrete

# Pour passer à Gemini :
# AI_PROVIDER=gemini
# GEMINI_API_KEY=colle-ici-ta-cle-secrete
# AI_MODEL=gemini-flash-latest